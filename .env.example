# Copy to .env and fill in. NEVER commit .env.
# Generate tokens with:  npm run gen-tokens
AGENT_TOKENS=planner:CHANGE_ME_planner_token_32chars_min,builder:CHANGE_ME_builder_token_32chars_min,reviewer:CHANGE_ME_reviewer_token_32chars_min

# Folder the agents may touch. Must NOT contain this project or your home folder.
WORKSPACE_ROOT=./workspace

HOST=127.0.0.1
PORT=3000
AUDIT_LOG=./logs/audit.jsonl

# Only for clients that cannot send an Authorization header (e.g. some web connectors).
# Enables POST /mcp/<token>. Tokens in URLs can leak into logs - leave false if you can.
ALLOW_PATH_TOKEN=false

# Your ngrok static domain (used by ecosystem.config.cjs), e.g. my-name.ngrok-free.app
NGROK_DOMAIN=
