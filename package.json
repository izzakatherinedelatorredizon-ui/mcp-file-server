{
  "name": "mcp-file-server",
  "version": "1.0.0",
  "description": "Sandboxed MCP file-server connector (Streamable HTTP) with git-lite, role-based tools and a handoff protocol",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsx --test test/sandbox.test.ts test/fileops.test.ts test/git.test.ts test/tools.test.ts test/auth.test.ts test/config.test.ts",
    "test:e2e": "tsx --test test/e2e.test.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "gen-tokens": "tsx scripts/gen-tokens.ts",
    "init-workspace": "tsx --env-file=.env scripts/init-workspace.ts",
    "init-workspace:demo": "tsx --env-file=.env scripts/init-workspace.ts --demo",
    "transcript": "tsx --env-file=.env scripts/transcript.ts",
    "inspector": "npx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^4.21.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
